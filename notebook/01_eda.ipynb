   "source": [
    "for feature in doctor_features:\n",
    "\n",
    "    # Calculate vaccination rates for the current feature\n",
    "    rates = (\n",
    "        cleaned_train_data_df\n",
    "        .groupby(feature)[\n",
    "            [\"h1n1_vaccine\", \"seasonal_vaccine\"]\n",
    "        ]\n",
    "        .mean()\n",
    "        .mul(100)\n",
    "        .rename(\n",
    "            columns={\n",
    "                \"h1n1_vaccine\": \"H1N1\",\n",
    "                \"seasonal_vaccine\": \"Seasonal\"\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # Create a readable feature name\n",
    "    feature_name = (\n",
    "        feature\n",
    "        .replace(\"_\", \" \")\n",
    "        .title()\n",
    "    )\n",
    "\n",
    "    # Display the percentage table\n",
    "    print(f\"\\nVaccination rates by {feature_name}\")\n",
    "    display(rates.round(1))\n",
    "\n",
    "    # Create the chart\n",
    "    ax = rates.plot(\n",
    "        kind=\"bar\",\n",
    "        figsize=(10, 5),\n",
    "        color=[\"#2A6F8A\", \"#E58A3A\"]\n",
    "    )\n",
    "\n",
    "    # Add percentage labels above every bar\n",
    "    for container in ax.containers:\n",
    "        ax.bar_label(\n",
    "            container,\n",
    "            fmt=\"%.1f%%\",\n",
    "            padding=3\n",
    "        )\n",
    "\n",
    "    # Format the chart\n",
    "    plt.title(\n",
    "        f\"Vaccine Uptake by {feature_name}\"\n",
    "    )\n",
    "\n",
    "    plt.xlabel(feature_name)\n",
    "    plt.ylabel(\"Vaccinated (%)\")\n",
    "    plt.ylim(0, 100)\n",
    "    plt.xticks(rotation=35)\n",
    "    plt.legend(title=\"Vaccine\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
